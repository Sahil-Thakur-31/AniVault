{
  "name": "anivault-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Anime & Manga Management Ecosystem",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npx tsx --test tests/acceptance.test.ts tests/api.test.ts",
    "dev:api": "npm --workspace=@anivault/api run dev",
    "dev:web": "npm --workspace=@anivault/web run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

